# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# openai | anthropic | gemini
LLM_PROVIDER=openai

# Override the provider default model if needed.
# OpenAI default: gpt-4.1-mini
# Anthropic default: claude-sonnet-4-5
# Gemini default: gemini-2.5-flash
# LLM_MODEL=gpt-4.1-mini

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# PDF extraction
# ---------------------------------------------------------------------------
# Maximum characters sent to the LLM across all input documents.
PDF_MAX_CHARS=80000

# 0 means all pages. Set a positive number to only process the first N pages.
PDF_MAX_PAGES=0

# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
SLACK_ENABLED=true

# auto picks webhook when SLACK_WEBHOOK_URL is set, otherwise the Web API.
# webhook | bot | auto
SLACK_MODE=auto

# Easiest option: create an Incoming Webhook for the target channel.
SLACK_WEBHOOK_URL=

# Alternative: a bot token with chat:write and a channel ID (or #channel-name).
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123456789

SLACK_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
CALENDAR_ENABLED=true

# service_account | oauth
GOOGLE_AUTH_MODE=service_account

# Service account mode. The calendar must be shared with the service account
# email (give it "Make changes to events" permission).
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json

# Optional domain-wide delegation subject. Normally leave blank.
# GOOGLE_SERVICE_ACCOUNT_SUBJECT=

# OAuth 2.0 mode. The first run opens a browser and writes the token file.
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=./credentials/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=./credentials/google-token.json

# "primary" works for OAuth. For a service account, use the shared calendar ID
# (often the calendar owner's email address, or from Calendar settings).
GOOGLE_CALENDAR_ID=primary

# IANA timezone used for interpreting dates and creating events.
TIMEZONE=UTC

# Fallback follow-up timing when the document does not specify a date.
FOLLOWUP_DEFAULT_DAYS=3
FOLLOWUP_DEFAULT_TIME=10:00
FOLLOWUP_DURATION_MINUTES=30

# Comma-separated attendee email addresses. Only these addresses are invited.
FOLLOWUP_ATTENDEES=

# Schedule a follow-up even when the LLM says one is not required.
FOLLOWUP_ALWAYS_SCHEDULE=false

# Reuse an existing event with the same source fingerprint and start time.
CALENDAR_DEDUPE=true

# ---------------------------------------------------------------------------
# Local output / logging
# ---------------------------------------------------------------------------
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
